# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude

# Local review scratch: contact sheets, a dumped page, the dev server's log and
# port file. All of it is regenerated on demand (`npm run plates -- --contact`)
# and none of it describes the project -- it describes one machine's last run.
/.preview/

# Rejected source photographs. Kept on disk so a decision can be revisited, but
# they are candidates that lost, not masters: roughly 16 MB that every clone
# would carry forever to hold pictures the site does not use. The Pexels id of
# each one is recorded in assets/photos/README.md, so any of them is one
# download away if a call needs reversing.
assets/photos/*.rejected.jpg
config.bat
